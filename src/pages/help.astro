---
const fallback = '/stable/help/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0;url=${fallback}`} />
    <title>FreeSense documentation help</title>
  </head>
  <body>
    <p><a href={fallback}>Open FreeSense documentation</a></p>
    <script>
      const params = new URLSearchParams(window.location.search);
      const version = params.get('version') || '';
      const edition = version.startsWith('1.1') ? 'devel' : 'stable';
      const page = params.get('page');
      const query = page ? `?page=${encodeURIComponent(page)}` : '';
      window.location.replace(`/${edition}/help/${query}`);
    </script>
  </body>
</html>
