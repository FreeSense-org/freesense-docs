---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import editions from '../data/editions.json';
import { editionForPath } from '../lib/edition.mjs';

const { sidebar } = Astro.locals.starlightRoute;
const label = editions[editionForPath(Astro.url.pathname)].label;
const selectedGroup = sidebar.find((entry) => entry.type === 'group' && entry.label === label);
const selectedSidebar = selectedGroup?.type === 'group' ? selectedGroup.entries : sidebar;
---

<SidebarSublist sublist={selectedSidebar} />

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
