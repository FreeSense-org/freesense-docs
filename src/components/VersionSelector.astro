---
import editions from '../data/editions.json';
import { editionForPath, editionNames, logicalPath } from '../lib/edition.mjs';
import { isPublishedIn } from '../data/navigation.mjs';

const pathname = Astro.url.pathname;
const currentEdition = editionForPath(pathname);
// The frozen edition has its own page set, so it links to its root.
const counterpartPath = (edition) => {
  if (edition === 'frozen' && currentEdition !== 'frozen') return `${editions.frozen.route_prefix}/`;
  if (currentEdition === 'frozen' && edition !== 'frozen') return `${editions[edition].route_prefix}/`;
  const path = logicalPath(pathname);
  const slug = path.replace(/^\/|\/$/g, '');
  if (slug && !isPublishedIn(slug, edition)) return `${editions[edition].route_prefix}/`;
  return `${editions[edition].route_prefix}${path}`;
};
---

<label class="edition-selector">
  <span class="edition-selector__label">Version</span>
  <select aria-label="Documentation version" data-version-selector>
    {
      editionNames.map((edition) => {
        const details = editions[edition];
        return (
        <option value={counterpartPath(edition)} selected={edition === currentEdition}>{details.label}</option>
        );
      })
    }
  </select>
</label>

<script>
  document.querySelectorAll('[data-version-selector]').forEach((element) => {
    element.addEventListener('change', () => {
      window.location.assign(element.value);
    });
  });
</script>
