---
import editions from '../data/editions.json';

const pathname = Astro.url.pathname;
const currentEdition = pathname === '/1.1' || pathname.startsWith('/1.1/') ? 'devel' : 'stable';
const counterpartPath = (edition) => {
  const logicalPath = currentEdition === 'devel' ? pathname.replace(/^\/1\.1(?=\/|$)/, '') : pathname;
  const normalizedPath = logicalPath === '' ? '/' : logicalPath;
  return `${editions[edition].route_prefix}${normalizedPath}`;
};
---

<label class="edition-selector">
  <span class="edition-selector__label">Version</span>
  <select aria-label="Documentation version" data-version-selector>
    {
      ['stable', 'devel'].map((edition) => {
        const details = editions[edition];
        return (
        <option value={counterpartPath(edition)} selected={edition === currentEdition}>{details.label}</option>
        );
      })
    }
  </select>
</label>

<script>
  document.querySelectorAll('[data-version-selector]').forEach((element) => {
    element.addEventListener('change', () => {
      window.location.assign(element.value);
    });
  });
</script>
