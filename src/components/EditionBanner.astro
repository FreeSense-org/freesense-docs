---
import editions from '../data/editions.json';

const pathname = Astro.url.pathname;
const edition = pathname === '/devel' || pathname.startsWith('/devel/')
  ? 'devel'
  : pathname === '/stable' || pathname.startsWith('/stable/')
    ? 'stable'
    : undefined;
---

{
  edition && (
    <div class:list={['edition-banner', `edition-banner--${edition}`]} data-pagefind-ignore>
      {edition === 'stable' ? (
        <span><strong>{editions.stable.label}</strong> is the current supported production documentation.</span>
      ) : (
        <span><strong>{editions.devel.label}</strong> is experimental and unsupported. Upgrading from 1.0 to 1.1 is one-way.</span>
      )}
    </div>
  )
}
